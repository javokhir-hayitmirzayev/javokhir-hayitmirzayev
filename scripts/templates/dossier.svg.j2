<svg width="850" height="{{ canvas_height }}" viewBox="0 0 850 {{ canvas_height }}" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <defs>
    <filter id="paperTexture" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" stitchTiles="stitch" result="noise"/>
      <feColorMatrix type="saturate" values="0" in="noise" result="mono"/>
      <feComponentTransfer in="mono">
        <feFuncA type="linear" slope="0.35"/>
      </feComponentTransfer>
    </filter>
    <clipPath id="mugshotClip">
      <rect x="34" y="164" width="130" height="164"/>
    </clipPath>
  </defs>

  <rect width="850" height="{{ canvas_height }}" fill="{{ C.bg }}"/>
  <rect width="850" height="{{ canvas_height }}" filter="url(#paperTexture)" opacity="0.05" style="pointer-events:none"/>

  <g font-family="'Courier New', Courier, monospace" font-size="12" fill="{{ C.ink }}">

    <!-- HEADER -->
    <text x="820" y="18" font-size="9" fill="{{ C.ink_soft }}" text-anchor="end">{{ document_id }} · REV {{ revision }}</text>
    <text x="30" y="26" font-size="13" font-weight="bold" letter-spacing="1">CASE FILE #{{ case_file }}</text>
    <text x="30" y="58" font-size="27" font-weight="bold">{{ display_name_upper }}</text>
    <text x="30" y="76" font-size="11" fill="{{ C.ink_soft }}">@{{ codename }}</text>
    <text x="30" y="96" font-size="12" font-style="italic" fill="{{ C.ink_soft }}">{{ classification }}</text>

    <g font-size="10" font-weight="bold">
      <rect x="30" y="108" width="108" height="20" rx="2" fill="none" stroke="{{ C.ink }}" stroke-width="1"/>
      <text x="40" y="122">STATUS · {{ status }}</text>
      <rect x="146" y="108" width="112" height="20" rx="2" fill="none" stroke="{{ C.accent }}" stroke-width="1"/>
      <text x="156" y="122" fill="{{ C.accent }}">THREAT · {{ threat_level }}</text>
    </g>

    <g transform="rotate(-11 730 84)" opacity="0.32">
      <rect x="655" y="56" width="150" height="54" fill="none" stroke="{{ C.accent }}" stroke-width="3.5" rx="4"/>
      <text x="730" y="91" font-family="Arial Black, Impact, sans-serif" font-size="21" fill="{{ C.accent }}" text-anchor="middle" font-weight="bold">TOP SECRET</text>
    </g>

    <rect x="30" y="144" width="790" height="3" fill="{{ C.ink }}"/>

    <!-- MUGSHOT + PROFILE + STATS ROW -->
    <rect x="30" y="{{ L.row_y }}" width="134" height="{{ L.row_h }}" fill="{{ C.tile }}" stroke="{{ C.ink }}" stroke-width="1.5"/>
    {% if has_mugshot %}
    <image x="34" y="{{ L.row_y + 4 }}" width="130" height="164" preserveAspectRatio="xMidYMid slice" clip-path="url(#mugshotClip)" href="{{ mugshot }}" xlink:href="{{ mugshot }}"/>
    {% else %}
    <ellipse cx="97" cy="{{ L.row_y + 60 }}" rx="32" ry="38" fill="{{ C.ink_soft }}" opacity="0.4"/>
    <ellipse cx="97" cy="{{ L.row_y + 128 }}" rx="44" ry="50" fill="{{ C.ink_soft }}" opacity="0.4"/>
    <text x="97" y="{{ L.row_y + 100 }}" text-anchor="middle" font-size="10" font-weight="bold" fill="{{ C.ink_soft }}">PHOTO REDACTED</text>
    {% endif %}
    <text x="97" y="{{ L.row_y + L.row_h - 10 }}" text-anchor="middle" font-size="9" font-weight="bold" fill="{{ C.ink }}" opacity="0.85">MUGSHOT — SUBJECT ID</text>

    <rect x="184" y="{{ L.row_y }}" width="386" height="{{ L.row_h }}" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="200" y="{{ L.row_y + 22 }}" font-weight="bold" font-size="12">SUBJECT PROFILE</text>
    {% set fields = [["Location", location], ["Phone", phone], ["Email", email], ["LinkedIn", linkedin], ["Website", website], ["GitHub Since", github_since ~ " · " ~ years_active ~ " yrs active"], ["Organizations", orgs]] %}
    {% for f in fields %}
    <text x="200" y="{{ L.row_y + 44 + loop.index0 * 21 }}" font-weight="bold" font-size="11">{{ f[0] }}</text>
    <text x="316" y="{{ L.row_y + 44 + loop.index0 * 21 }}" font-size="11">{{ f[1] }}</text>
    {% endfor %}

    <rect x="590" y="{{ L.row_y }}" width="230" height="{{ L.row_h }}" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="606" y="{{ L.row_y + 22 }}" font-weight="bold" font-size="12">BY THE NUMBERS</text>
    {% for s in stats %}
    {% set col = loop.index0 % 2 %}
    {% set row = loop.index0 // 2 %}
    <text x="{{ 606 + col * 108 }}" y="{{ L.row_y + 48 + row * 36 }}" font-size="9" fill="{{ C.ink_soft }}">{{ s.label | upper }}</text>
    <text x="{{ 606 + col * 108 }}" y="{{ L.row_y + 64 + row * 36 }}" font-size="15" font-weight="bold">{{ s.value }}</text>
    {% endfor %}

    <!-- SUMMARY -->
    <rect x="30" y="{{ L.summary_rule }}" width="790" height="1.5" fill="{{ C.ink }}" opacity="0.5"/>
    <rect x="30" y="{{ L.summary_box }}" width="790" height="{{ L.summary_h }}" fill="{{ C.tile }}" stroke="{{ C.ink }}" stroke-width="1"/>
    <text x="46" y="{{ L.summary_box + 20 }}" font-weight="bold" font-size="11">SUMMARY</text>
    {% for line in summary %}
    <text x="46" y="{{ L.summary_box + 40 + loop.index0 * 16 }}" font-size="11">{{ line }}</text>
    {% endfor %}

    <!-- TECHNICAL ARSENAL -->
    <rect x="30" y="{{ L.arsenal_rule }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <text x="30" y="{{ L.arsenal_title }}" font-size="16" font-weight="bold">TECHNICAL ARSENAL — PRIMARY LANGUAGES</text>
    <rect x="30" y="{{ L.arsenal_rule2 }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <rect x="30" y="{{ L.arsenal_box }}" width="790" height="{{ L.arsenal_h }}" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    {% if languages %}
      {% for lang in languages %}
      <text x="46" y="{{ L.arsenal_box + 24 + loop.index0 * 28 }}" font-weight="bold">{{ lang.name_esc }}</text>
      {% if loop.index0 == 0 %}
      <text x="120" y="{{ L.arsenal_box + 24 + loop.index0 * 28 }}" font-size="9" fill="{{ C.accent }}" font-weight="bold">PRIMARY</text>
      {% endif %}
      <rect x="200" y="{{ L.arsenal_box + 14 + loop.index0 * 28 }}" width="170" height="8" fill="{{ C.ink }}" opacity="0.15"/>
      <rect x="200" y="{{ L.arsenal_box + 14 + loop.index0 * 28 }}" width="{{ lang.width }}" height="8" fill="{{ C.ink }}"/>
      <text x="390" y="{{ L.arsenal_box + 24 + loop.index0 * 28 }}" text-anchor="end">{{ lang.pct }}%</text>
      {% endfor %}
    {% else %}
      <text x="46" y="{{ L.arsenal_box + 28 }}">No public language intelligence available</text>
    {% endif %}

    <!-- FRAMEWORK INTELLIGENCE -->
    <rect x="30" y="{{ L.fw_rule }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <text x="30" y="{{ L.fw_title }}" font-size="16" font-weight="bold">FRAMEWORK INTELLIGENCE — DETECTED CAPABILITIES</text>
    <rect x="30" y="{{ L.fw_rule2 }}" width="790" height="2.5" fill="{{ C.ink }}"/>

    <rect x="30" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="46" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">BACKEND</text>
    {% for item in frameworks.backend[:7] %}
    <text x="46" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="300" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="316" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">FRONTEND</text>
    {% for item in frameworks.frontend[:7] %}
    <text x="316" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="570" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="586" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">DATABASE</text>
    {% for item in frameworks.database[:7] %}
    <text x="586" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="30" y="{{ L.fw_row2 }}" width="385" height="120" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="46" y="{{ L.fw_row2 + 22 }}" font-weight="bold" font-size="13">DEVOPS</text>
    {% for item in frameworks.devops[:5] %}
    <text x="46" y="{{ L.fw_row2 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="435" y="{{ L.fw_row2 }}" width="385" height="120" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="451" y="{{ L.fw_row2 + 22 }}" font-weight="bold" font-size="13">TOOLS</text>
    {% for item in frameworks.tools[:5] %}
    <text x="451" y="{{ L.fw_row2 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <!-- HIGH VALUE ASSETS -->
    <rect x="30" y="{{ L.assets_rule }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <text x="30" y="{{ L.assets_title }}" font-size="16" font-weight="bold">HIGH VALUE ASSETS — PRIORITY REPOSITORIES</text>
    <rect x="30" y="{{ L.assets_rule2 }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    {% if assets %}
      {% for asset in assets %}
      <rect x="{{ asset.x }}" y="{{ asset.y }}" width="385" height="88" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 22 }}" font-weight="bold" font-size="13">{{ asset.name }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 40 }}">{{ asset.description }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 58 }}" font-size="11" fill="{{ C.accent }}">{{ asset.star_bar }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 76 }}" font-size="10" fill="{{ C.ink_soft }}">{{ asset.language }}  ·  ★{{ asset.stars }}  ·  {{ asset.updated }}</text>
      {% endfor %}
    {% else %}
      <rect x="30" y="{{ L.assets_box }}" width="790" height="40" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
      <text x="46" y="{{ L.assets_box + 26 }}">No public repositories on record</text>
    {% endif %}

    <!-- ACTIVE OPS / INTELLIGENCE -->
    <rect x="30" y="{{ L.ops_rule }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <text x="30" y="{{ L.ops_title }}" font-size="16" font-weight="bold">ACTIVE OPERATIONS  /  RECENT INTELLIGENCE</text>
    <rect x="30" y="{{ L.ops_rule2 }}" width="790" height="2.5" fill="{{ C.ink }}"/>

    <rect x="30" y="{{ L.ops_box }}" width="385" height="150" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="46" y="{{ L.ops_box + 22 }}" font-weight="bold" font-size="13">ACTIVE OPERATIONS</text>
    <text x="46" y="{{ L.ops_box + 46 }}" font-weight="bold">Current Repository</text>
    <text x="46" y="{{ L.ops_box + 62 }}">{{ active_repo }}</text>
    <text x="46" y="{{ L.ops_box + 82 }}" font-weight="bold">Branch</text>
    <text x="200" y="{{ L.ops_box + 82 }}">{{ active_branch }}</text>
    <text x="46" y="{{ L.ops_box + 100 }}" font-weight="bold">Last Commit</text>
    <text x="46" y="{{ L.ops_box + 116 }}">{{ active_commit }}</text>
    <text x="46" y="{{ L.ops_box + 136 }}" font-size="10" fill="{{ C.ink_soft }}">{{ active_time }}  ·  {{ active_mission }}</text>

    <rect x="435" y="{{ L.ops_box }}" width="385" height="150" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="451" y="{{ L.ops_box + 22 }}" font-weight="bold" font-size="13">RECENT INTELLIGENCE</text>
    {% for line in intelligence[:7] %}
    <text x="451" y="{{ L.ops_box + 42 + loop.index0 * 15 }}" font-size="11">✓ {{ line }}</text>
    {% endfor %}

    <!-- THREAT / FIELD NOTES -->
    <rect x="30" y="{{ L.threat_rule }}" width="790" height="2.5" fill="{{ C.ink }}"/>
    <text x="30" y="{{ L.threat_title }}" font-size="16" font-weight="bold">THREAT ASSESSMENT  /  FIELD NOTES</text>
    <rect x="30" y="{{ L.threat_rule2 }}" width="790" height="2.5" fill="{{ C.ink }}"/>

    <rect x="30" y="{{ L.threat_box }}" width="385" height="200" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="46" y="{{ L.threat_box + 22 }}" font-weight="bold" font-size="13">THREAT ASSESSMENT</text>
    {% for item in threat_assessment %}
    <text x="46" y="{{ L.threat_box + 46 + loop.index0 * 22 }}" font-size="11">{{ item.label_esc }}</text>
    <rect x="200" y="{{ L.threat_box + 38 + loop.index0 * 22 }}" width="170" height="7" fill="{{ C.ink }}" opacity="0.15"/>
    <rect x="200" y="{{ L.threat_box + 38 + loop.index0 * 22 }}" width="{{ item.width }}" height="7" fill="{{ C.ink }}"/>
    {% endfor %}

    <rect x="435" y="{{ L.threat_box }}" width="385" height="200" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"/>
    <text x="451" y="{{ L.threat_box + 22 }}" font-weight="bold" font-size="13">FIELD NOTES</text>
    <text x="451" y="{{ L.threat_box + 42 }}" font-weight="bold" font-size="11">Known For</text>
    {% for note in known_for[:8] %}
    <text x="451" y="{{ L.threat_box + 60 + loop.index0 * 14 }}" font-size="11">• {{ note }}</text>
    {% endfor %}
    <text x="451" y="{{ L.threat_box + 186 }}" font-weight="bold" font-size="11">Current Status  {{ field_status }}</text>

    <!-- FOOTER -->
    <rect x="30" y="{{ L.footer_rule }}" width="790" height="2" fill="{{ C.ink }}" opacity="0.6"/>
    <text x="30" y="{{ L.footer_meta }}" font-size="10" fill="{{ C.ink_soft }}">SOURCE GitHub API · UPDATED {{ generated_at }} · REV v{{ revision }} · VERIFICATION {{ clearance_note }} · STATUS {{ mission_status }}</text>
    <text x="30" y="{{ L.footer_meta + 18 }}" font-size="8" fill="{{ C.ink_soft }}">PAGE 1 OF 1  ·  DOCUMENT {{ document_id }}  ·  ARCHIVE COPY</text>
    <text x="820" y="{{ L.footer_meta + 18 }}" font-size="8" fill="{{ C.ink_soft }}" text-anchor="end">SECURITY LEVEL IV  ·  CONFIDENTIAL</text>
  </g>
</svg>

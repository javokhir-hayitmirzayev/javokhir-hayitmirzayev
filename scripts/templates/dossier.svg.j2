<svg width="850" height="{{ canvas_height }}" viewBox="0 0 850 {{ canvas_height }}" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <defs>
    <filter id="paperTexture" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" stitchTiles="stitch" result="noise"/>
      <feColorMatrix type="saturate" values="0" in="noise" result="mono"/>
      <feComponentTransfer in="mono">
        <feFuncA type="linear" slope="0.4"/>
      </feComponentTransfer>
    </filter>
    <clipPath id="mugshotClip">
      <rect x="34" y="148" width="132" height="168"/>
    </clipPath>
  </defs>

  <rect width="850" height="{{ canvas_height }}" fill="#F5E6C5"/>
  <rect width="850" height="{{ canvas_height }}" filter="url(#paperTexture)" opacity="0.03" style="pointer-events:none"/>

  <g transform="rotate(-18 680 105)" opacity="0.34">
    <rect x="580" y="66" width="200" height="78" fill="none" stroke="#A14A3B" stroke-width="4" rx="4"/>
    <text x="680" y="114" font-family="Arial Black, Impact, sans-serif" font-size="26" fill="#A14A3B" text-anchor="middle" font-weight="bold">TOP SECRET</text>
  </g>

  <g font-family="Courier New, Courier, monospace" font-size="12" fill="#2B2B2B">

    <!-- HEADER -->
    <text x="30" y="26" font-size="15" font-weight="bold" fill="#3A3228">CASE FILE #{{ case_file }}</text>
    <text x="30" y="64" font-size="30" font-weight="bold">{{ display_name_upper }}</text>
    <text x="30" y="92" font-size="12" font-weight="bold" font-style="italic" fill="#3A3228">CLASSIFICATION:</text>
    <text x="30" y="110" font-size="12" font-style="italic">{{ classification }}</text>
    <rect x="30" y="124" width="790" height="3" fill="#3A3228"/>

    <!-- MUGSHOT -->
    <rect x="30" y="144" width="140" height="210" fill="#D4CBB8" stroke="#3A3228" stroke-width="1.5"/>
    {% if has_mugshot %}
    <image x="34" y="148" width="132" height="168" preserveAspectRatio="xMidYMid slice" clip-path="url(#mugshotClip)" href="{{ mugshot }}" xlink:href="{{ mugshot }}"/>
    <text x="100" y="200" text-anchor="middle" font-size="11" font-weight="bold" fill="#A14A3B" opacity="0.28" transform="rotate(-18 100 200)">CONFIDENTIAL</text>
    {% else %}
    <ellipse cx="100" cy="200" rx="34" ry="40" fill="#A89F8C"/>
    <ellipse cx="100" cy="278" rx="46" ry="52" fill="#A89F8C"/>
    <text x="100" y="255" text-anchor="middle" font-size="10" font-weight="bold" fill="#5A5348">PHOTO REDACTED</text>
    {% endif %}
    <text x="100" y="335" text-anchor="middle" font-size="10" font-weight="bold" fill="#3A3228">MUGSHOT</text>
    <text x="100" y="348" text-anchor="middle" font-size="9" fill="#5A5348">SUBJECT IDENTIFIED</text>

    <!-- SUBJECT PROFILE -->
    <rect x="186" y="144" width="634" height="210" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="202" y="166" font-weight="bold" font-size="13">SUBJECT PROFILE</text>
    <text x="202" y="188" font-weight="bold">Name</text>
    <text x="320" y="188">{{ display_name }}</text>
    <text x="202" y="206" font-weight="bold">Codename</text>
    <text x="320" y="206">{{ codename }}</text>
    <text x="202" y="224" font-weight="bold">Status</text>
    <text x="320" y="224">{{ status }}</text>
    <text x="202" y="242" font-weight="bold">GitHub Since</text>
    <text x="320" y="242">{{ github_since }}</text>
    <text x="202" y="260" font-weight="bold">Location</text>
    <text x="320" y="260">{{ location }}</text>
    <text x="202" y="278" font-weight="bold">Phone</text>
    <text x="320" y="278">{{ phone }}</text>
    <text x="202" y="296" font-weight="bold">Email</text>
    <text x="320" y="296">{{ email }}</text>
    <text x="202" y="314" font-weight="bold">LinkedIn</text>
    <text x="320" y="314">{{ linkedin }}</text>
    <text x="202" y="332" font-weight="bold">Last Seen</text>
    <text x="320" y="332">{{ last_seen }}</text>

    <rect x="560" y="180" width="240" height="154" fill="#E9E1CF" stroke="#3A3228" stroke-width="0.75"/>
    <text x="574" y="200" font-size="10" font-weight="bold">IDENTIFICATION</text>
    <text x="574" y="220" font-size="10" font-weight="bold">Followers</text>
    <text x="740" y="220" font-size="10" text-anchor="end">{{ followers }}</text>
    <text x="574" y="238" font-size="10" font-weight="bold">Following</text>
    <text x="740" y="238" font-size="10" text-anchor="end">{{ following }}</text>
    <text x="574" y="256" font-size="10" font-weight="bold">Repositories</text>
    <text x="740" y="256" font-size="10" text-anchor="end">{{ public_repos }}</text>
    <text x="574" y="274" font-size="10" font-weight="bold">Organizations</text>
    <text x="574" y="290" font-size="10">{{ orgs }}</text>
    <text x="574" y="310" font-size="10" font-weight="bold">Website</text>
    <text x="574" y="326" font-size="10">{{ website }}</text>

    <!-- MISSION RECORD -->
    <rect x="30" y="374" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="400" font-size="18" font-weight="bold">MISSION RECORD — OPERATIONAL STATISTICS</text>
    <rect x="30" y="410" width="790" height="2.5" fill="#3A3228"/>

    <rect x="30" y="426" width="385" height="168" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="448" font-weight="bold">Operations Completed</text>
    <text x="390" y="448" text-anchor="end">{{ ops_completed }}</text>
    <text x="46" y="470" font-weight="bold">Deployments</text>
    <text x="390" y="470" text-anchor="end">{{ deployments }}</text>
    <text x="46" y="492" font-weight="bold">Known Associates</text>
    <text x="390" y="492" text-anchor="end">{{ associates }}</text>
    <text x="46" y="514" font-weight="bold">Intelligence Sources</text>
    <text x="390" y="514" text-anchor="end">{{ intel_sources }}</text>
    <text x="46" y="536" font-weight="bold">Pull Requests</text>
    <text x="390" y="536" text-anchor="end">{{ pull_requests }}</text>
    <text x="46" y="558" font-weight="bold">Cases Closed</text>
    <text x="390" y="558" text-anchor="end">{{ cases_closed }}</text>
    <text x="46" y="580" font-size="10" fill="#5A5348">Repos · FOLLOWERS · FOLLOWING · PRs · ISSUES</text>

    <rect x="435" y="426" width="385" height="168" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="451" y="448" font-weight="bold">Stars Earned</text>
    <text x="795" y="448" text-anchor="end">{{ stars_earned }}</text>
    <text x="451" y="470" font-weight="bold">Forked Operations</text>
    <text x="795" y="470" text-anchor="end">{{ forked_ops }}</text>
    <text x="451" y="492" font-weight="bold">Latest Deployment</text>
    <text x="795" y="492" text-anchor="end">{{ latest_deployment }}</text>
    <text x="451" y="514" font-weight="bold">Mission Status</text>
    <text x="795" y="514" text-anchor="end">{{ mission_status }}</text>
    <text x="451" y="536" font-weight="bold">Threat Level</text>
    <text x="795" y="536" text-anchor="end">{{ threat_level }}</text>
    <text x="451" y="558" font-weight="bold">Clearance</text>
    <text x="795" y="558" text-anchor="end">{{ clearance }}</text>
    <text x="451" y="580" font-size="10" fill="#5A5348">STARS · FORKS · ACTIVITY · STATUS</text>

    <!-- TECHNICAL ARSENAL -->
    <rect x="30" y="{{ L.arsenal_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.arsenal_title }}" font-size="18" font-weight="bold">TECHNICAL ARSENAL — PRIMARY LANGUAGES</text>
    <rect x="30" y="{{ L.arsenal_rule2 }}" width="790" height="2.5" fill="#3A3228"/>
    <rect x="30" y="{{ L.arsenal_box }}" width="790" height="{{ L.arsenal_h }}" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    {% if languages %}
      {% for lang in languages %}
      <text x="46" y="{{ L.arsenal_box + 24 + loop.index0 * 28 }}" font-weight="bold">{{ lang.name_esc }}</text>
      <rect x="200" y="{{ L.arsenal_box + 14 + loop.index0 * 28 }}" width="170" height="8" fill="#3A3228" opacity="0.15"/>
      <rect x="200" y="{{ L.arsenal_box + 14 + loop.index0 * 28 }}" width="{{ lang.width }}" height="8" fill="#3A3228"/>
      <text x="390" y="{{ L.arsenal_box + 24 + loop.index0 * 28 }}" text-anchor="end">{{ lang.pct }}%</text>
      {% endfor %}
    {% else %}
      <text x="46" y="{{ L.arsenal_box + 28 }}">No public language intelligence available</text>
    {% endif %}

    <!-- FRAMEWORK INTELLIGENCE -->
    <rect x="30" y="{{ L.fw_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.fw_title }}" font-size="18" font-weight="bold">FRAMEWORK INTELLIGENCE — DETECTED CAPABILITIES</text>
    <rect x="30" y="{{ L.fw_rule2 }}" width="790" height="2.5" fill="#3A3228"/>

    <rect x="30" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">BACKEND</text>
    {% for item in frameworks.backend[:7] %}
    <text x="46" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="300" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="316" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">FRONTEND</text>
    {% for item in frameworks.frontend[:7] %}
    <text x="316" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="570" y="{{ L.fw_row1 }}" width="250" height="160" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="586" y="{{ L.fw_row1 + 22 }}" font-weight="bold" font-size="13">DATABASE</text>
    {% for item in frameworks.database[:7] %}
    <text x="586" y="{{ L.fw_row1 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="30" y="{{ L.fw_row2 }}" width="385" height="120" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="{{ L.fw_row2 + 22 }}" font-weight="bold" font-size="13">DEVOPS</text>
    {% for item in frameworks.devops[:5] %}
    <text x="46" y="{{ L.fw_row2 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <rect x="435" y="{{ L.fw_row2 }}" width="385" height="120" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="451" y="{{ L.fw_row2 + 22 }}" font-weight="bold" font-size="13">TOOLS</text>
    {% for item in frameworks.tools[:5] %}
    <text x="451" y="{{ L.fw_row2 + 42 + loop.index0 * 16 }}">• {{ item }}</text>
    {% endfor %}

    <!-- HIGH VALUE ASSETS -->
    <rect x="30" y="{{ L.assets_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.assets_title }}" font-size="18" font-weight="bold">HIGH VALUE ASSETS — PRIORITY REPOSITORIES</text>
    <rect x="30" y="{{ L.assets_rule2 }}" width="790" height="2.5" fill="#3A3228"/>
    {% if assets %}
      {% for asset in assets %}
      <rect x="{{ asset.x }}" y="{{ asset.y }}" width="385" height="88" fill="none" stroke="#3A3228" stroke-width="1.5"/>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 22 }}" font-weight="bold" font-size="13">{{ asset.name }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 40 }}">{{ asset.description }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 58 }}" font-size="11" fill="#A14A3B">{{ asset.star_bar }}</text>
      <text x="{{ asset.x + 16 }}" y="{{ asset.y + 76 }}" font-size="10" fill="#5A5348">{{ asset.language }}  ·  ★{{ asset.stars }}  ·  {{ asset.updated }}</text>
      {% endfor %}
    {% else %}
      <rect x="30" y="{{ L.assets_box }}" width="790" height="40" fill="none" stroke="#3A3228" stroke-width="1.5"/>
      <text x="46" y="{{ L.assets_box + 26 }}">No public repositories on record</text>
    {% endif %}

    <!-- ACTIVE OPS / INTELLIGENCE -->
    <rect x="30" y="{{ L.ops_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.ops_title }}" font-size="18" font-weight="bold">ACTIVE OPERATIONS  /  RECENT INTELLIGENCE</text>
    <rect x="30" y="{{ L.ops_rule2 }}" width="790" height="2.5" fill="#3A3228"/>

    <rect x="30" y="{{ L.ops_box }}" width="385" height="150" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="{{ L.ops_box + 22 }}" font-weight="bold" font-size="13">ACTIVE OPERATIONS</text>
    <text x="46" y="{{ L.ops_box + 46 }}" font-weight="bold">Current Repository</text>
    <text x="46" y="{{ L.ops_box + 62 }}">{{ active_repo }}</text>
    <text x="46" y="{{ L.ops_box + 82 }}" font-weight="bold">Branch</text>
    <text x="200" y="{{ L.ops_box + 82 }}">{{ active_branch }}</text>
    <text x="46" y="{{ L.ops_box + 100 }}" font-weight="bold">Last Commit</text>
    <text x="46" y="{{ L.ops_box + 116 }}">{{ active_commit }}</text>
    <text x="46" y="{{ L.ops_box + 136 }}" font-size="10" fill="#5A5348">{{ active_time }}  ·  {{ active_mission }}</text>

    <rect x="435" y="{{ L.ops_box }}" width="385" height="150" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="451" y="{{ L.ops_box + 22 }}" font-weight="bold" font-size="13">RECENT INTELLIGENCE</text>
    {% for line in intelligence[:7] %}
    <text x="451" y="{{ L.ops_box + 42 + loop.index0 * 15 }}" font-size="11">✓ {{ line }}</text>
    {% endfor %}

    <!-- THREAT / FIELD NOTES -->
    <rect x="30" y="{{ L.threat_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.threat_title }}" font-size="18" font-weight="bold">THREAT ASSESSMENT  /  FIELD NOTES</text>
    <rect x="30" y="{{ L.threat_rule2 }}" width="790" height="2.5" fill="#3A3228"/>

    <rect x="30" y="{{ L.threat_box }}" width="385" height="200" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="{{ L.threat_box + 22 }}" font-weight="bold" font-size="13">THREAT ASSESSMENT</text>
    {% for item in threat_assessment %}
    <text x="46" y="{{ L.threat_box + 46 + loop.index0 * 22 }}" font-size="11">{{ item.label_esc }}</text>
    <rect x="200" y="{{ L.threat_box + 38 + loop.index0 * 22 }}" width="170" height="7" fill="#3A3228" opacity="0.15"/>
    <rect x="200" y="{{ L.threat_box + 38 + loop.index0 * 22 }}" width="{{ item.width }}" height="7" fill="#3A3228"/>
    {% endfor %}

    <rect x="435" y="{{ L.threat_box }}" width="385" height="200" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="451" y="{{ L.threat_box + 22 }}" font-weight="bold" font-size="13">FIELD NOTES</text>
    <text x="451" y="{{ L.threat_box + 42 }}" font-weight="bold" font-size="11">Known For</text>
    {% for note in known_for[:8] %}
    <text x="451" y="{{ L.threat_box + 60 + loop.index0 * 14 }}" font-size="11">• {{ note }}</text>
    {% endfor %}
    <text x="451" y="{{ L.threat_box + 186 }}" font-weight="bold" font-size="11">Current Status  {{ field_status }}</text>

    <!-- OPERATIONAL METRICS -->
    <rect x="30" y="{{ L.metrics_rule }}" width="790" height="2.5" fill="#3A3228"/>
    <text x="30" y="{{ L.metrics_title }}" font-size="18" font-weight="bold">OPERATIONAL METRICS</text>
    <rect x="30" y="{{ L.metrics_rule2 }}" width="790" height="2.5" fill="#3A3228"/>
    <rect x="30" y="{{ L.metrics_box }}" width="790" height="88" fill="none" stroke="#3A3228" stroke-width="1.5"/>
    <text x="46" y="{{ L.metrics_box + 24 }}" font-weight="bold">Primary Language</text>
    <text x="260" y="{{ L.metrics_box + 24 }}">{{ primary_language }}</text>
    <text x="430" y="{{ L.metrics_box + 24 }}" font-weight="bold">Most Active Repo</text>
    <text x="600" y="{{ L.metrics_box + 24 }}">{{ most_active_repo }}</text>
    <text x="46" y="{{ L.metrics_box + 46 }}" font-weight="bold">Years Active</text>
    <text x="260" y="{{ L.metrics_box + 46 }}">{{ years_active }}</text>
    <text x="430" y="{{ L.metrics_box + 46 }}" font-weight="bold">Current Streak</text>
    <text x="600" y="{{ L.metrics_box + 46 }}">{{ current_streak }} days</text>
    <text x="46" y="{{ L.metrics_box + 68 }}" font-weight="bold">Longest Streak</text>
    <text x="260" y="{{ L.metrics_box + 68 }}">{{ longest_streak }} days</text>
    <text x="430" y="{{ L.metrics_box + 68 }}" font-weight="bold">Verification</text>
    <text x="600" y="{{ L.metrics_box + 68 }}">{{ clearance_note }}</text>

    <!-- FOOTER -->
    <rect x="30" y="{{ L.footer_rule }}" width="790" height="2" fill="#3A3228" opacity="0.6"/>
    <text x="30" y="{{ L.footer_rule + 24 }}" font-size="13" font-weight="bold">CASE FILE GENERATED</text>

    <rect x="30" y="{{ L.footer_meta }}" width="120" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="38" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">SOURCE</text>
    <text x="38" y="{{ L.footer_meta + 30 }}" font-size="9">GitHub API</text>

    <rect x="160" y="{{ L.footer_meta }}" width="160" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="168" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">LAST UPDATED</text>
    <text x="168" y="{{ L.footer_meta + 30 }}" font-size="9">{{ generated_at }}</text>

    <rect x="330" y="{{ L.footer_meta }}" width="100" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="338" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">REVISION</text>
    <text x="338" y="{{ L.footer_meta + 30 }}" font-size="9">v{{ revision }}</text>

    <rect x="440" y="{{ L.footer_meta }}" width="120" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="448" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">CLEARANCE</text>
    <text x="448" y="{{ L.footer_meta + 30 }}" font-size="9">PUBLIC PROFILE</text>

    <rect x="570" y="{{ L.footer_meta }}" width="110" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="578" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">VERIFICATION</text>
    <text x="578" y="{{ L.footer_meta + 30 }}" font-size="9">{{ clearance_note }}</text>

    <rect x="690" y="{{ L.footer_meta }}" width="130" height="40" fill="none" stroke="#3A3228" stroke-width="0.75"/>
    <text x="698" y="{{ L.footer_meta + 16 }}" font-size="9" font-weight="bold">STATUS</text>
    <text x="698" y="{{ L.footer_meta + 30 }}" font-size="9">{{ mission_status }}</text>

    <text x="30" y="{{ L.footer_meta + 60 }}" font-size="8" fill="#3A3228">PAGE 1 OF 1  ·  DOCUMENT {{ document_id }}  ·  ARCHIVE COPY</text>
    <text x="820" y="{{ L.footer_meta + 60 }}" font-size="8" fill="#3A3228" text-anchor="end">SECURITY LEVEL IV  ·  CONFIDENTIAL</text>
  </g>

  <g transform="rotate(-10 720 {{ L.footer_meta + 20 }})" opacity="0.34">
    <rect x="640" y="{{ L.footer_meta - 10 }}" width="160" height="58" fill="none" stroke="#A14A3B" stroke-width="4" rx="3"/>
    <text x="720" y="{{ L.footer_meta + 25 }}" font-family="Arial Black, Impact, sans-serif" font-size="20" fill="#A14A3B" text-anchor="middle" font-weight="bold">APPROVED</text>
  </g>
</svg>
